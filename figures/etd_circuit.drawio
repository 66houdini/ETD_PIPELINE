        <mxCell id="mains" value="AC MAINS&#xa;220-240 V, 50 Hz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
