        <mxCell id="pzemB" value="PZEM-B&#xa;(Point B)&#xa;Metered load only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
