        <mxCell id="neutral" value="SHARED NEUTRAL BUS  (screw terminal)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1">
