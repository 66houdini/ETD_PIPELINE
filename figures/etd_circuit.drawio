          <mxGeometry x="120" y="330" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="note" value="GAP = P_A − P_B&#xa;&#xa;Switch OPEN:  P_A ≈ P_B  →  GAP ≈ 0 W  →  normal&#xa;Switch CLOSED: P_A ≈ 2×P_B →  GAP ≈ 11 W →  THEFT&#xa;&#xa;Alarm threshold: GAP &gt; 10.0 W" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
